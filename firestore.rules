rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function validWords(d) {
      return d.a is string && d.a.size() > 0 && d.a.size() <= 40
        && d.b is string && d.b.size() > 0 && d.b.size() <= 40
        && d.cat is string && d.cat.size() > 0 && d.cat.size() <= 30;
    }
    function validVotes(d) {
      return (!('up' in d) || (d.up is int && d.up >= 0))
        && (!('down' in d) || (d.down is int && d.down >= 0));
    }
    // Une note ne peut qu'ajouter 1 à « up » ou à « down ».
    function plusOne(field) {
      return request.resource.data.get(field, 0) >= resource.data.get(field, 0)
        && request.resource.data.get(field, 0) <= resource.data.get(field, 0) + 1;
    }

    match /pairs/{pairId} {
      allow read: if true;

      // Ajout (ou restauration depuis la corbeille, qui garde les notes).
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['a', 'b', 'cat', 'by', 'createdAt', 'up', 'down'])
        && request.resource.data.keys().hasAll(['a', 'b', 'cat', 'by', 'createdAt'])
        && validWords(request.resource.data)
        && validVotes(request.resource.data)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Notes : seulement +1 sur « up » ou « down ».
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['up', 'down'])
        && plusOne('up') && plusOne('down');

      allow delete: if request.auth != null;
    }

    // Agents : nom, photo (JPEG réduit en base64), points et stats, partagés entre téléphones.
    function count(d, f) {
      return d.get(f, 0) is int && d.get(f, 0) >= 0;
    }
    function validAgent(d) {
      return d.keys().hasOnly(['name', 'photo', 'createdAt', 'points', 'games', 'wins',
          'civilG', 'civilW', 'underG', 'underW', 'whiteG', 'whiteW', 'firstOut', 'survived', 'guessed'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && (d.get('photo', null) == null || (d.photo is string && d.photo.size() < 200000))
        && count(d, 'points') && count(d, 'games') && count(d, 'wins')
        && count(d, 'civilG') && count(d, 'civilW') && count(d, 'underG') && count(d, 'underW')
        && count(d, 'whiteG') && count(d, 'whiteW')
        && count(d, 'firstOut') && count(d, 'survived') && count(d, 'guessed');
    }

    match /agents/{agentId} {
      allow read: if true;
      allow create, update: if request.auth != null && validAgent(request.resource.data);
      allow delete: if request.auth != null;
    }

    // Corbeille : historique des paires supprimées, restaurables.
    match /trash/{trashId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['a', 'b', 'cat', 'up', 'down', 'pairId', 'deletedAt'])
        && validWords(request.resource.data)
        && validVotes(request.resource.data)
        && request.resource.data.pairId is string
        && request.resource.data.deletedAt == request.time;
      allow delete: if request.auth != null;
    }
  }
}
