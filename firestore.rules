rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /pairs/{pairId} {
      // Tout le monde peut lire les paires.
      allow read: if true;

      // Ajout : utilisateur connecté (anonyme), deux mots de 1 à 40 caractères,
      // une catégorie de 1 à 30 caractères, exactement ces champs,
      // auteur = soi-même, date = heure du serveur.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['a', 'b', 'cat', 'by', 'createdAt'])
        && request.resource.data.keys().hasAll(['a', 'b', 'cat', 'by', 'createdAt'])
        && request.resource.data.a is string
        && request.resource.data.a.size() > 0 && request.resource.data.a.size() <= 40
        && request.resource.data.b is string
        && request.resource.data.b.size() > 0 && request.resource.data.b.size() <= 40
        && request.resource.data.cat is string
        && request.resource.data.cat.size() > 0 && request.resource.data.cat.size() <= 30
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Suppression : par n'importe quel joueur connecté.
      allow delete: if request.auth != null;

      allow update: if false;
    }
  }
}
